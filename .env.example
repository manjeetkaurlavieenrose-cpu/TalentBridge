# Copy this file to ".env" (same folder) to change settings. Every line is optional: the defaults run the full demo.
# Values below are placeholders/examples only. Never put real passwords or keys in a file you share or upload.

# ---- Where things run -------------------------------------------------------------------------------------------
# PORT=5050                       # macOS reserves 5000 for AirPlay, so the default is 5050
# DATA_DIR=./data                 # database + uploaded CVs live here (back this folder up to keep your data)
# DEMO_SEED=1                     # 1 = create the public demo logins on first start. Set to 0 for anything real.

# ---- AI engine ----------------------------------------------------------------------------------------------------
# Leave AI_PROVIDER unset and TalentBridge decides at start-up: if the free Ollama program is installed on this computer it is
# used automatically (and its model is downloaded once, in the background); otherwise the built-in rule-based engine runs.
# No account, key or payment is involved either way. Set TB_AUTO_AI=0 to switch this automatic choice off.
# AI_PROVIDER=local               # local: built-in rule-based engine, free, offline, instant
#                                 # ollama: free local model through Ollama (Windows, macOS, Linux) - recommended
#                                 # openai: any OpenAI-compatible server - LM Studio / Jan / llama.cpp (local, free), or Groq,
#                                 #         OpenRouter, Google Gemini (hosted, free tiers) - set OPENAI_BASE_URL/MODEL/API_KEY
#                                 # anthropic: Claude API (paid; needs ANTHROPIC_API_KEY and requirements-anthropic.txt)
# AI_TASKS=profile,summary,assessment,evaluation   # what the model does: CV reading, fit summary, questions, scoring
#
# Ollama (https://ollama.com):  ollama pull qwen2.5:3b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b         # 1.9 GB; qwen2.5:7b gives better questions and scoring on a machine with 16 GB RAM
# OLLAMA_TIMEOUT=180
# OLLAMA_NUM_CTX=8192             # context window sent to the model (room for a whole CV)
#
# OpenAI-compatible server examples (pick one):
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1                 # LM Studio (Developer tab > Start server)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1          # Groq (free tier, needs OPENAI_API_KEY)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # Google Gemini (free tier)
# OPENAI_MODEL=qwen2.5-7b-instruct
# OPENAI_API_KEY=your-key-here    # not needed for LM Studio / Jan / llama.cpp
#
# Claude API:
# ANTHROPIC_API_KEY=your-key-here
# AI_MODEL=claude-opus-5-5
#
# Meaning-based CV/job similarity (shown next to the match):
# SEMANTIC_MATCH=1                # uses the AI server's embeddings: Ollama needs  ollama pull nomic-embed-text
# SEMANTIC_BACKEND=ollama         # ollama | openai | sentence-transformers (default follows AI_PROVIDER)
# EMBED_MODEL=nomic-embed-text

# ---- Scanned CVs (OCR) ------------------------------------------------------------------------------------------------
# OCR=auto                        # auto: read scanned PDFs when Tesseract (or RapidOCR) is installed | off
# OCR_LANG=eng                    # Tesseract language(s), e.g. eng+hin
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # only if Tesseract is somewhere unusual

# ---- Database -----------------------------------------------------------------------------------------------------
# DATABASE_URL=postgresql://talentbridge@localhost:5433/talentbridge   # default: SQLite file in DATA_DIR
#                                 # copy existing SQLite data first: python3 scripts/sqlite_to_postgres.py --to <url>

# ---- E-mail ---------------------------------------------------------------------------------------------------------
# EMAIL_PROVIDER=file             # file (default): saved to data/outbox, nothing is sent | resend | brevo | smtp
# EMAIL_FROM=onboarding@resend.dev   # Resend: a verified domain, or onboarding@resend.dev (delivers only to your own account e-mail)
#                                 # Brevo: an address verified under Senders in your Brevo account
# RESEND_API_KEY=                 # from resend.com > API Keys (free tier). Never commit a real key.
# BREVO_API_KEY=                  # from brevo.com > SMTP & API > API Keys (free tier)
# EMAIL_ALLOWED_RECIPIENTS=you@example.org,@your-university.example   # real mail ONLY goes to these; others are held
# EMAIL_ALLOW_ALL=0               # 1 = mail every recipient. Only with consent from real candidates.
# Test: python3 scripts/send_test_email.py --to you@example.org

# ---- Privacy ------------------------------------------------------------------------------------------------------
# CANDIDATE_SEES_RESULTS=1        # 0 = candidates do not see their match breakdown / scores

# ---- First admin for a REAL setup (leave blank for the demo) -------------------------------------------------------
# ADMIN_EMAIL=you@example.org
# ADMIN_PASSWORD=choose-a-long-unique-password
