# Copy to .env.production, replace every CHANGE_ME value, and keep that file private.
PUBLIC_HOST=yourname.duckdns.org
PUBLIC_URL=https://yourname.duckdns.org
ALLOWED_ORIGINS=https://yourname.duckdns.org

# Use a unique generated value (for example: openssl rand -hex 32).
POSTGRES_DB=talentbridge
POSTGRES_USER=talentbridge
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# First administrator account. Change this password after handover.
ADMIN_EMAIL=professor@example.edu
ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_LONG_PASSWORD

DEMO_SEED=0
EMBEDDED_WORKER=0
COOKIE_SECURE=1
TRUSTED_PROXIES=1
RATE_LIMIT_BACKEND=db
UPLOAD_DIR=/data/uploads

AI_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TASKS=profile,summary,assessment,evaluation
OLLAMA_TIMEOUT=300

# Keep email explicitly in the local outbox until a real provider and sender are configured.
EMAIL_PROVIDER=file
